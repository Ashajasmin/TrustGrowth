# ---------- Gemini ----------
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
TG_MODEL=gemini-3.1-pro
TG_THINKING_LEVEL=high

# If the model above is busy (503 "high demand") the app retries, then falls back to these, in order.
# TG_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest
# TG_LLM_ATTEMPTS=4

# ---------- Email OTP (required, the server will not start without these) ----------
# Signs login tickets and conversation tokens. Must be 32+ characters.
AUTH_SECRET=PASTE_GENERATED_SECRET_HERE

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=ashajasminkumar@gmail.com
SMTP_PASSWORD=PASTE_YOUR_16_CHAR_GMAIL_APP_PASSWORD_HERE
# Sender: keep it identical to the login address. Gmail rewrites or flags a mismatched name/address, which
# pushes codes into spam. Once you own a domain, use e.g. no-reply@yourdomain.com with a sending service (below).
SMTP_FROM=ashajasminkumar@gmail.com

# ---------- Better deliverability (use once you own a domain) ----------
# 1. Add SPF, DKIM and DMARC DNS records at your domain registrar (the service below shows the exact values).
# 2. Replace the four SMTP_* lines above with your provider's, for example:
#      Brevo      SMTP_HOST=smtp-relay.brevo.com          SMTP_PORT=587  SMTP_SECURITY=starttls
#      SendGrid   SMTP_HOST=smtp.sendgrid.net             SMTP_PORT=587  SMTP_USERNAME=apikey
#      Postmark   SMTP_HOST=smtp.postmarkapp.com          SMTP_PORT=587
#      Amazon SES SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
#    SMTP_USERNAME / SMTP_PASSWORD are the credentials the provider gives you (not your Gmail password).
# 3. SMTP_FROM=TrustGrowth <no-reply@yourdomain.com>   (the domain must be the one you verified with the provider)

# Optional: minutes a verified conversation stays open (default 480)
# AUTH_SESSION_TTL_MIN=480